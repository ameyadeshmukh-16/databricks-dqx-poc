# Databricks Connect (local development only — NOT needed on Databricks cluster)
DATABRICKS_HOST=https://<workspace-id>.azuredatabricks.net/
DATABRICKS_TOKEN=<your-databricks-personal-access-token>
DATABRICKS_CLUSTER_ID=<your-cluster-id>

# Azure Storage (ADLS Gen2) — used by Spark to write Delta tables and checkpoints
# Find in Azure Portal → Storage Account → Security + networking → Access Keys → key1
AZURE_STORAGE_KEY=<your-adls-gen2-storage-account-key>

# Azure Event Hubs connection string — reused as the Kafka SASL password
# Find in Azure Portal → Event Hubs namespace → Shared Access Policies → RootManageSharedAccessKey
# IMPORTANT: use the NAMESPACE-level connection string (no EntityPath suffix)
EVENTHUB_CONN_STR=Endpoint=sb://<namespace>.servicebus.windows.net/;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=<key>

# Kafka / Azure Event Hubs Kafka Protocol Endpoint
# Port 9093 is the Kafka-compatible endpoint on Azure Event Hubs (NOT the SDK default 5671)
KAFKA_BOOTSTRAP_SERVERS=<namespace>.servicebus.windows.net:9093

# Event Hub name — used as both the Kafka topic and the DQX rule filter
KAFKA_TOPIC=<event-hub-name>

# Consumer group for Spark Structured Streaming — create in Azure Portal if it doesn't exist
KAFKA_CONSUMER_GROUP=<consumer-group-name>

# ---------------------------------------------------------------------------
# AI Rule Suggester — add only the backend(s) you intend to use
# ---------------------------------------------------------------------------

# Claude (Anthropic) — https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=<your-anthropic-api-key>
# Optional: override the default model
CLAUDE_MODEL=claude-sonnet-4-6

# Azure OpenAI — Azure Portal → Azure OpenAI resource → Keys and Endpoint
AZURE_OPENAI_API_KEY=<your-azure-openai-key>
AZURE_OPENAI_ENDPOINT=https://<resource-name>.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=<your-deployment-name>      # e.g. gpt-4o
AZURE_OPENAI_API_VERSION=2024-02-01

# OpenRouter — https://openrouter.ai/keys (free-tier models available, no credit required)
# Browse free models: https://openrouter.ai/models?q=free
OPENROUTER_API_KEY=<your-openrouter-api-key>
# Optional: pick a specific free model (defaults to openrouter/auto if not set)
OPENROUTER_MODEL=mistralai/mistral-7b-instruct:free
# OPENAI_BASE_URL=https://openrouter.ai/api/v1   # only needed if overriding the default endpoint

# Which backend to use: "claude" | "azure_openai" | "openrouter"
LLM_BACKEND=openrouter

# ---------------------------------------------------------------------------
# Alerting — Data Quality spike notifications
# ---------------------------------------------------------------------------

# Slack Incoming Webhook — https://api.slack.com/messaging/webhooks
# On Databricks, store this as a secret and read it via dbutils.secrets.get()
# rather than a plaintext job parameter.
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/<workspace>/<channel>/<token>
